<configuration>

  <appender class="ch.qos.logback.core.ConsoleAppender"
    name="Console">
    <layout class="ch.qos.logback.classic.PatternLayout">
      <Pattern>
        %green(%d{ISO8601}) %highlight(%-5level) [%blue(%t)] %yellow(%C{1.}): %msg%n%throwable
      </Pattern>
    </layout>
  </appender>

  <appender class="ch.qos.logback.core.rolling.RollingFileAppender"
    name="RollingFile">
    <encoder
      class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d %p %C{1.} [%t] %m%n</Pattern>
    </encoder>
    <file>./log/ne-upgrade.log</file>

    <rollingPolicy
      class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <!-- rollover daily and when the file reaches 10 MegaBytes -->
      <fileNamePattern>./log/ne-upgrade-%d{yyyy-MM-dd}.%i.log
      </fileNamePattern>
      <maxHistory>10</maxHistory>
      <timeBasedFileNamingAndTriggeringPolicy
        class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
        <maxFileSize>50MB</maxFileSize>
      </timeBasedFileNamingAndTriggeringPolicy>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <appender class="ch.qos.logback.core.rolling.RollingFileAppender"
    name="notifier">
    <encoder
      class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d %p %C{1.} [%t] %m%n</Pattern>
    </encoder>
    <file>./log/notification.log</file>

    <rollingPolicy
      class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <!-- rollover daily and when the file reaches 10 MegaBytes -->
      <fileNamePattern>./log/notification-%d{yyyy-MM-dd}.%i.log
      </fileNamePattern>
      <maxHistory>10</maxHistory>
      <timeBasedFileNamingAndTriggeringPolicy
        class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
        <maxFileSize>50MB</maxFileSize>
      </timeBasedFileNamingAndTriggeringPolicy>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="NET_CONF_FILE">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | NE: %X{neId:-unknown} | %msg%n</pattern>
    </encoder>
    <file>./log/net_conf_execute.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>./log/net_conf_execute.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
  </appender>
  <logger additivity="false" level="error" name="org.springframework.we">
    <appender-ref ref="RollingFile"/>
  </logger>

  <logger additivity="false" level="info"
    name="net.flex.dci.otc.common.aspect">
    <appender-ref ref="notifier"/>
  </logger>

  <!-- LOG everything at INFO level -->
  <logger additivity="false" level="OFF" name="org.mongodb.driver">
  </logger>
  
  <!-- RPC调用日志 -->
  <root level="info">
    <appender-ref ref="RollingFile"/>
    <appender-ref ref="Console"/>
  </root>
</configuration>