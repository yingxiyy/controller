<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <artifactId>controller</artifactId>
    <groupId>net.flex.dci.otn</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <description>controller status service</description>
  <groupId>net.flex.dci.otn.controller.status</groupId>
  <artifactId>status</artifactId>

  <name>status</name>


  <properties>
    <!-- Keep this service aligned with the controller Java 21 baseline. -->
    <java.version>21</java.version>
    <maven-jar-plugin.version>3.1.1</maven-jar-plugin.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

  </properties>

  <dependencies>
    <dependency>
      <artifactId>spring-boot-starter-web</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-test</artifactId>
      <groupId>org.springframework.boot</groupId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <artifactId>netconf-serialization</artifactId>
      <groupId>net.flex.dci.otc</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.flex.dci.otc.cache</groupId>
      <artifactId>dci-cache</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>common-model</artifactId>
      <groupId>net.flex.dci.otc.common</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>db-mysql</artifactId>
      <groupId>net.flex.dci.otc</groupId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <artifactId>mysql-connector-java</artifactId>
      <groupId>mysql</groupId>
    </dependency>

    <dependency>
      <artifactId>db-mongo</artifactId>
      <groupId>net.flex.dci.otc</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.flex.dci.otc.zk</groupId>
      <artifactId>zkclient4boot</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <artifactId>rpc-client</artifactId>
      <groupId>net.flex.dci.otn</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.flex.dci.otn.controller.tools</groupId>
      <artifactId>kafka</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.flex.dci.otn.controller.tools</groupId>
      <artifactId>webapp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.flex.dci.otc</groupId>
      <artifactId>dci-i18n-support</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
        <groupId>com.github.ben-manes.caffeine</groupId>
        <artifactId>caffeine</artifactId>
        <version>2.8.8</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${basedir}/src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/application*.yml</include>
          <include>zkclient_conf.properties</include>
          <include>logback-spring.xml</include>
          <include>tag-info</include>
        </includes>
      </resource>
      <resource>
        <directory>${basedir}/src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>mongodb.properties</include>
          <include>mysql.properties</include>
          <include>cache.properties</include>
          <include>*.json</include>
        </includes>
      </resource>
    </resources>


    <plugins>
      <plugin>
        <!-- curl http://localhost:8080/actuator/info to get git info-->
        <groupId>pl.project13.maven</groupId>
        <artifactId>git-commit-id-plugin</artifactId>
        <version>4.9.10</version>
        <executions>
          <execution>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>net.flex.dci.otc.plugin</groupId>
        <artifactId>systemd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>


  <profiles>
    <profile>
      <id>product</id>
      <build>
        <plugins>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>
</project>
