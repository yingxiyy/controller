<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>system-rest</artifactId>
  <name>system-rest</name>
  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <resources>
      <resource>
        <directory>${basedir}/src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/application*.yml</include>
          <include>zkclient_conf.properties</include>
          <include>logback-spring.xml</include>
          <include>ehcache.xml</include>
          <include>*.json</include>
          <include>*.tab</include>
          <include>tag-info</include>
        </includes>
      </resource>
      <resource>
        <directory>${basedir}/src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>mysql.properties</include>
          <include>cache.properties</include>
          <include>mongodb.properties</include>
        </includes>
      </resource>
    </resources>


    <plugins>
      <plugin>
        <!-- curl http://localhost:8080/actuator/info to get git info-->
        <groupId>pl.project13.maven</groupId>
        <artifactId>git-commit-id-plugin</artifactId>
        <version>4.9.10</version>
        <executions>
          <execution>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>net.flex.dci.otc.plugin</groupId>
        <artifactId>systemd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>


  <profiles>
    <profile>
      <id>product</id>
      <build>
        <plugins>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <artifactId>spring-boot-starter</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-web</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>webapp</artifactId>
      <groupId>net.flex.dci.otn.controller.tools</groupId>
    </dependency>
    <dependency>
      <artifactId>mail</artifactId>
      <groupId>net.flex.dci.otn.controller</groupId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <artifactId>zkclient4boot</artifactId>
      <groupId>net.flex.dci.otc.zk</groupId>
    </dependency>
    <dependency>
      <artifactId>subscribe</artifactId>
      <groupId>net.flex.dci.otn.controller</groupId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <artifactId>system-cache</artifactId>
      <groupId>net.flex.dci.otn.controller</groupId>
    </dependency>
    <dependency>
      <groupId>net.flex.dci.otn.controller</groupId>
      <artifactId>system-config</artifactId>
    </dependency>
    <dependency>
      <groupId>net.flex.dci.otn.controller.system</groupId>
      <artifactId>system-common</artifactId>
    </dependency>

  </dependencies>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>system-config-manager</artifactId>
    <groupId>net.flex.dci.otn.controller</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <os-maven-plugin.version>1.6.0</os-maven-plugin.version>
    <template.dir>${project.basedir}/../../tools/templates</template.dir>

  </properties>

</project>