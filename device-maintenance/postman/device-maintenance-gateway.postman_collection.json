{
  "info": {
    "_postman_id": "device-maintenance-gateway-001",
    "name": "Device Maintenance - Gateway Access",
    "description": "通过Gateway（8088端口）访问Device Maintenance服务的测试集合\n\n使用方法：\n1. 先运行 Authentication > Get OAuth2 Token 获取访问令牌\n2. Token会自动保存到环境变量中\n3. 所有后续请求会自动使用该Token\n\n环境变量：\n- 使用 \"Device Maintenance - Gateway (Shanghai)\" 环境",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get OAuth2 Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has access_token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.exist;",
                  "    pm.environment.set(\"access_token\", jsonData.access_token);",
                  "    pm.environment.set(\"token_type\", jsonData.token_type);",
                  "    console.log(\"✅ Token获取成功\");",
                  "    console.log(\"  有效期:\", jsonData.expires_in, \"秒\");",
                  "    console.log(\"  Token已保存到环境变量: access_token\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{auth_base}}/oauth2/token?username={{oauth_username}}&password={{oauth_password}}&client_id={{oauth_client_id}}&client_secret={{oauth_client_secret}}&scope={{oauth_scope}}&grant_type={{oauth_grant_type}}",
              "host": [
                "{{auth_base}}"
              ],
              "path": [
                "oauth2",
                "token"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "{{oauth_username}}"
                },
                {
                  "key": "password",
                  "value": "{{oauth_password}}"
                },
                {
                  "key": "client_id",
                  "value": "{{oauth_client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{oauth_client_secret}}"
                },
                {
                  "key": "scope",
                  "value": "{{oauth_scope}}"
                },
                {
                  "key": "grant_type",
                  "value": "{{oauth_grant_type}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Software Download",
      "item": [
        {
          "name": "立即下载软件",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Task created successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.exist;",
                  "    pm.expect(jsonData.data.taskId).to.exist;",
                  "    ",
                  "    // 保存taskId供后续测试使用",
                  "    pm.environment.set(\"test_task_id\", jsonData.data.taskId);",
                  "    ",
                  "    console.log(\"✅ 软件下载任务已创建\");",
                  "    console.log(\"  任务ID:\", jsonData.data.taskId);",
                  "    console.log(\"  设备ID:\", jsonData.data.deviceId);",
                  "    console.log(\"  文件路径:\", jsonData.data.filePath);",
                  "    console.log(\"  状态:\", jsonData.data.status);",
                  "});"
